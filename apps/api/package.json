{
  "name": "@fuellink/api",
  "version": "0.2.0",
  "private": true,
  "description": "FuelLink API — NestJS + Prisma + Postgres. Exchange core: auth/RBAC, depot registry, escrow state machine (bank-held escrow via Providus — bank integration lands with API access + legal structure).",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && tsx watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.0.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.2.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.0.0",
    "jest": "^30.5.2",
    "prisma": "^6.0.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
