# FuelLink API — environment
# Local setup:
#   ../../scripts/dev-db.sh        # provision + start PostgreSQL
#   cp .env.example .env

NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://fuellink:fuellink@127.0.0.1:5432/fuellink?schema=public
# Integration tests run against a SEPARATE database; they reset it on every run.
TEST_DATABASE_URL=postgresql://fuellink:fuellink@127.0.0.1:5432/fuellink_test?schema=public

# --- Auth ---
# Generate each with: openssl rand -hex 32   (must differ from each other)
JWT_ACCESS_SECRET=dev-only-access-secret-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-fedcba9876543210fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost
# MUST be true in production (enforced at boot).
COOKIE_SECURE=false
# Scales rate limits; MUST be 1 in production (enforced at boot).
RATE_LIMIT_FACTOR=1
LOG_LEVEL=info

# --- Trading policy ---
# Hours a buyer has to confirm delivery before escrow auto-releases.
DELIVERY_AUTO_CONFIRM_HOURS=72
# Short-delivery tolerance, basis points of ordered volume (50 = 0.5%).
DELIVERY_VARIANCE_TOLERANCE_BPS=50
# Default platform commission in basis points (100 = 1%).
DEFAULT_FEE_BPS=100
MAX_UPLOAD_BYTES=10485760

# --- Escrow account (manual bank-transfer provider) ---
# Buyers transfer here; an operator confirms the credit against the narration.
# Payments are refused outright if these are unset — no half-configured flows.
ESCROW_BANK_NAME=
ESCROW_ACCOUNT_NAME=
ESCROW_ACCOUNT_NUMBER=

# --- Providus bank-held escrow (add when credentials land) ---
# PROVIDUS_API_BASE=
# PROVIDUS_API_KEY=
# PROVIDUS_API_SECRET=
