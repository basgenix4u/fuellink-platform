# FuelLink API — environment
# Copy to .env for local dev:  cp .env.example .env

NODE_ENV=development
PORT=4000

# Postgres — with `docker compose up -d` this is the bundled dev instance
DATABASE_URL=postgresql://fuellink:fuellink@localhost:5432/fuellink?schema=public

# JWT — minimum 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=12h

# Comma-separated CORS origins (production web app is on fuellink.ng)
CORS_ORIGINS=https://fuellink.ng,http://localhost:3000

# --- Phase 2 later: Providus bank-held escrow (uncomment when credentials land) ---
# PROVIDUS_API_BASE=https://api.providusbank.com
# PROVIDUS_API_KEY=
# PROVIDUS_API_SECRET=
