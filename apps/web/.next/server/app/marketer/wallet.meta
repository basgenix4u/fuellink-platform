{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/marketer/layout,_N_T_/marketer/wallet/layout,_N_T_/marketer/wallet/page,_N_T_/marketer/wallet"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/marketer/wallet/__PAGE__",
    "/marketer/wallet",
    "/marketer",
    "/_index",
    "/_head"
  ]
}