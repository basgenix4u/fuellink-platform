{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/marketer/layout,_N_T_/marketer/settings/layout,_N_T_/marketer/settings/page,_N_T_/marketer/settings"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/marketer/settings/__PAGE__",
    "/marketer/settings",
    "/marketer",
    "/_index",
    "/_head"
  ]
}