{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/marketer/layout,_N_T_/marketer/refineries/layout,_N_T_/marketer/refineries/page,_N_T_/marketer/refineries"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/marketer/refineries/__PAGE__",
    "/marketer/refineries",
    "/marketer",
    "/_index",
    "/_head"
  ]
}