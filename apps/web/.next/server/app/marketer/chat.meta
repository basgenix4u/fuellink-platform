{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/marketer/layout,_N_T_/marketer/chat/layout,_N_T_/marketer/chat/page,_N_T_/marketer/chat"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/marketer/chat/__PAGE__",
    "/marketer/chat",
    "/marketer",
    "/_index",
    "/_head"
  ]
}