{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/marketer/layout,_N_T_/marketer/messages/layout,_N_T_/marketer/messages/page,_N_T_/marketer/messages"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/marketer/messages/__PAGE__",
    "/marketer/messages",
    "/marketer",
    "/_index",
    "/_head"
  ]
}